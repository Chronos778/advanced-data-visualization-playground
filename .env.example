# Advanced Data Visualization Playground - Environment Variables

# Hugging Face API Key (for AI Insights feature)
# Get your free API key at: https://huggingface.co/settings/tokens
# The AI Insights feature uses Meta Llama 3.3 70B model
# If not provided, the app will use local statistical analysis as fallback
REACT_APP_HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Optional: Future integrations
# REACT_APP_OPENAI_API_KEY=your_openai_api_key_here
# REACT_APP_ANTHROPIC_API_KEY=your_anthropic_api_key_here
